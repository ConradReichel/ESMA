# DNS records for APP_DOMAIN and AUTH_DOMAIN must point to this server.
APP_DOMAIN=app.example.org
AUTH_DOMAIN=auth.example.org

# Use unique generated secrets in production.
POSTGRES_USER=esma
POSTGRES_PASSWORD=replace-with-a-long-random-password
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=replace-with-another-long-random-password

# local | s3 | azure-blob
STORAGE_DRIVER=local
# S3 settings (required when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Azure settings (required when STORAGE_DRIVER=azure-blob)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=chicken-images

# Optional Wix synchronization
WIX_API_KEY=
WIX_SITE_ID=
WIX_COLLECTION_ID=Patenhuehner

# Optional origin for public cross-origin API calls (e.g. a Wix site)
CORS_ORIGIN=https://www.example.org
